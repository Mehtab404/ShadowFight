[layer_names]

2d_physics/layer_1="pushbox"
2d_physics/layer_2="hurtbox_p1"
2d_physics/layer_3="hitbox_p1"
2d_physics/layer_4="hurtbox_p2"
2d_physics/layer_5="hitbox_p2"
2d_physics/layer_6="environment"

[physics]

common/physics_ticks_per_second=60
2d/default_gravity=980.0

[rendering]

renderer/rendering_method="forward_plus"
environment/defaults/default_clear_color=Color(0.08, 0.08, 0.1, 1)
